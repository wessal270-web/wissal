
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the authenticated user matches the userId in the path
    function isPathOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the current user has the 'admin' role in their user profile
    // safe check: verify doc exists before getting data
    function isAdmin() {
       return isAuthenticated() && 
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- 1. User Subcollections (Explicit Matches) ---
    // This allows Presidents to manage their own associations/news
    match /users/{userId}/associations/{docId} {
      allow read: if true;
      // Allow owner to create without admin check (simpler/safer)
      allow create: if isPathOwner(userId);
      // Allow owner OR admin to update/delete
      allow update, delete: if isPathOwner(userId) || isAdmin();
    }

    match /users/{userId}/news/{docId} {
      allow read: if true;
      allow create: if isPathOwner(userId);
      allow update, delete: if isPathOwner(userId) || isAdmin();
    }

    // --- 2. User Profiles ---
    match /users/{userId} {
      allow read: if true; 
      // Allow user to register/update their own profile
      allow create, update: if isPathOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- 3. Root Collections (Legacy/Fallback) ---
    match /associations/{docId} {
      allow read: if true;
      // Allow creation by any authenticated user (legacy support)
      allow create: if isAuthenticated();
      // Update/Delete requires ownership or admin rights
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
    }

    match /news/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 4. Collection Group Queries (Public Read) ---
    match /{path=**}/associations/{docId} {
      allow read: if true;
    }
    match /{path=**}/news/{docId} {
      allow read: if true;
    }

    // --- 5. System Collections ---
    match /stats/{docId} {
       allow read, write: if true;
    }
    match /presence/{docId} {
       allow read, write: if true;
    }
  }
}
